---
/**
 * The one button. Style guide §9.1.
 *   primary – warm grey fill, white text → blush fill, ink text on hover
 *   outline – 1px text-colored border → filled on hover
 *   link    – uppercase rose text link with underline
 * Sizes: sm (header), md (default), lg. No icons or arrows inside labels.
 * Renders <a> when `href` is set, otherwise <button>.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'> & {
  variant?: 'primary' | 'outline' | 'link';
  size?: 'sm' | 'md' | 'lg';
  /** Stretch to full width (mobile stacks, sticky book bar). */
  block?: boolean;
  class?: string;
};

const { variant = 'primary', size = 'md', block = false, class: className, href, type, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className];
---

<Tag class:list={classes} href={href} type={href ? undefined : (type ?? 'button')} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: fit-content;
    border-radius: var(--radius-btn);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .17em;
    white-space: nowrap;
    transition: background-color .3s, color .3s, border-color .3s, text-decoration-thickness .3s;
  }
  .btn--sm { padding: 10px 18px; font-size: 13px; }
  .btn--md { padding: 12px 24px; }
  .btn--lg { padding: 14px 28px; }
  .btn--block { width: 100%; }

  .btn--primary {
    color: var(--color-white);
    background: var(--color-btn);
  }
  .btn--outline {
    color: var(--color-text);
    border: 1px solid var(--color-text);
  }
  .btn--link {
    padding: 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .05em;
    color: var(--color-rose-text);
    text-decoration: underline 1px;
    text-underline-offset: 4px;
  }

  @media (hover: hover) {
    .btn--primary:hover { color: var(--color-ink); background: var(--color-blush); }
    .btn--outline:hover { color: var(--color-white); background: var(--color-text); }
    .btn--link:hover { text-decoration-thickness: 2px; }
  }

  @media (width <= 1100px) {
    .btn--md, .btn--lg { font-size: 14px; }
  }

  .btn:disabled,
  .btn.is-loading {
    opacity: .65;
    cursor: progress;
  }
</style>
